# Copy to `keystore.properties` — which is gitignored — and fill in.
#
# The release build signs itself only when this file exists, or when the four
# LINEO_KEYSTORE_* / LINEO_KEY_* environment variables are set. With neither, the
# release build still builds, unsigned: CI checks the APK against the 12 MB ceiling
# (P1-10-0) on every push, and it has no business holding a signing key to do that.
#
# Generate the upload key with:
#
#   keytool -genkeypair -v -keystore lineo-upload.jks -alias lineo-upload \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# Play App Signing holds the app signing key; this is only the *upload* key, and it is
# replaceable — but replacing it costs a support round trip, so back it up in two places
# before the first upload. P1-11 says two on purpose: one is not a backup.

storeFile=lineo-upload.jks
storePassword=
keyAlias=lineo-upload
keyPassword=
