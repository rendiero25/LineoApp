<?xml version="1.0" encoding="utf-8"?>
<!--
    The same decision as `data_extraction_rules.xml`, for API 26–30, where the platform has
    only one kind of backup and it is the cloud one.

    Auto Backup on those versions cannot tell a cloud copy from a device transfer, so there
    is nothing to keep: a document that would be uploaded is excluded, and `docs/
    ANDROID_STANDARDS.md` §5 is unambiguous about which way that trade goes for a calculator
    people put their salary into.

    An `<exclude>` with no matching `<include>` is how "nothing" is written here: the format
    backs up everything by default, so each domain has to be named to be refused.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="file" />
    <exclude domain="external" />
</full-backup-content>
