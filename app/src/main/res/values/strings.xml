<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name">Lineo</string>
    <!--
      The Play Store title (P1-11), 25 characters. Nothing in the app draws it — the launcher
      shows `app_name` and the listing is typed into the Console — but it lives here so the
      title has one source that travels with the code and is translated with everything else.
      Lint is told so rather than the string being deleted and re-typed from a doc.
    -->
    <string name="full_app_title" tools:ignore="UnusedResources">Lineo: Notepad Calculator</string>

    <!-- Spoken label for the overflow affordance in the top corner. -->
    <string name="history_title">History</string>
    <string name="history_empty">Nothing yet. Calculations you finish appear here.</string>
    <string name="history_clear">Clear history</string>

    <string name="settings_title">Settings</string>
    <string name="settings_separator">Decimal separator</string>
    <string name="settings_separator_auto">Auto</string>
    <string name="settings_separator_dot">1.5</string>
    <string name="settings_separator_comma">1,5</string>
    <string name="settings_angle_mode">Angle mode</string>
    <string name="settings_theme">Theme</string>
    <string name="settings_theme_system">System</string>
    <string name="settings_theme_light">Light</string>
    <string name="settings_theme_dark">Dark</string>
    <string name="settings_unit_system">Unit system</string>
    <string name="settings_unit_system_auto">Auto</string>
    <string name="settings_unit_system_metric">Metric</string>
    <string name="settings_unit_system_imperial">Imperial</string>
    <string name="settings_decimal_places">Decimal places</string>
    <string name="settings_dynamic_color">Follow wallpaper colours</string>
    <string name="settings_dynamic_color_subtitle">Use the colours of your wallpaper instead of Lineo&#8217;s palette</string>
    <string name="settings_licences">Open-source licences</string>
    <string name="settings_licences_subtitle">What ships inside Lineo, and under which terms</string>
    <string name="licences_missing_text">No bundled text for %1$s</string>

    <!--
        Spoken accessibility labels. An action label finishes the sentence TalkBack starts
        with "double tap to", so each one is a verb phrase and not a title.
    -->
    <string name="licences_show_text">show the licence</string>
    <string name="licences_hide_text">hide the licence</string>
    <string name="licences_state_shown">Licence shown</string>
    <string name="licences_state_hidden">Licence hidden</string>
    <string name="history_reuse_action">put this calculation back in the notepad</string>

    <string name="menu_more_options">More options</string>

    <!--
        Title of the document created on the first run. Not shown anywhere yet — the document
        list is P3-06 — but it is stored, so it is written in the user's language from the
        start rather than migrated later.
    -->
    <string name="notepad_default_title">Notepad</string>
</resources>
