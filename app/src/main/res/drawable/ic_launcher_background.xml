<?xml version="1.0" encoding="utf-8"?>
<!--
    The pale end of Lineo's own palette — `primaryContainerLight` from `docs/LineoCP`,
    #EBE68D. Flat on purpose: an adaptive background is masked into whatever shape the
    launcher wants, and a gradient or a pattern reads as a smear once the mask is a circle
    on one device and a squircle on the next.

    It does not follow the theme. Adaptive icon layers are drawn as authored in both light
    and dark launchers, so the pale ground is chosen to carry the olive mark in either.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#EBE68D"
        android:pathData="M0,0h108v108h-108z" />
</vector>
