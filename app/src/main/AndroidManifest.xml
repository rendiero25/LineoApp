<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        **No <uses-permission> here, and that is the finished state, not an oversight.**
        docs/ANDROID_STANDARDS.md §5 allows exactly INTERNET and ACCESS_NETWORK_STATE, and
        both are for currency rates and ads — neither of which exists yet. A permission is
        declared by the change that needs it (P2-03 for rates), so a reviewer reading this
        manifest today sees a calculator that asks for nothing at all.

        One permission does appear in the merged manifest: androidx.core declares
        `app.lineo.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION`, a signature-level permission it
        grants only to itself so its own runtime receivers are not exported. It is not a
        capability and is not requestable by anyone else.

        enableOnBackInvokedCallback opts into predictive back (API 33+; the attribute is
        ignored below that, hence tools:targetApi). docs/ANDROID_STANDARDS.md §2 requires it:
        without the opt-in the system cannot animate the gesture, and the user gets no
        preview of where back is about to take them.

        usesCleartextTraffic="false" alongside the network security config: the config is what
        the platform enforces from API 24, and the attribute is what a reviewer reads.
    -->
    <application
        android:name=".LineoApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="tiramisu"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lineo">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Lineo"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>