<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        enableOnBackInvokedCallback opts into predictive back (API 33+; the attribute is
        ignored below that, hence tools:targetApi). docs/ANDROID_STANDARDS.md §2 requires it:
        without the opt-in the system cannot animate the gesture, and the user gets no
        preview of where back is about to take them.
    -->
    <application
        android:name=".LineoApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="tiramisu"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lineo">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Lineo"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>