<resources>

    <!--
        Spoken labels for keys whose glyph says nothing out loud. Keys whose label is already
        a word or a number carry no description: TalkBack reads the label, and a redundant
        one would have it read twice.
    -->
    <string name="key_all_clear_description">Clear line</string>
    <string name="key_backspace_description">Backspace</string>
    <string name="key_percent_description">Percent</string>
    <string name="key_divide_description">Divide</string>
    <string name="key_multiply_description">Multiply</string>
    <string name="key_subtract_description">Subtract</string>
    <string name="key_add_description">Add</string>
    <string name="key_equals_description">Equals</string>
    <string name="key_decimal_separator_description">Decimal separator</string>
    <string name="key_text_keyboard_description">Text keyboard</string>

    <string name="key_open_bracket_description">Open bracket</string>
    <string name="key_toggle_sign_description">Positive or negative</string>
    <string name="key_close_bracket_description">Close bracket</string>
    <string name="key_power_description">To the power of</string>
    <string name="key_square_root_description">Square root</string>
    <string name="key_argument_separator_description">Argument separator</string>
    <string name="key_numeric_keypad_description">Calculator keypad</string>

    <!--
        The two key labels that are words rather than notation. `ABC` names a script and
        `123` a number system, so both change with the language — a Cyrillic user is shown
        their own three letters. Every other key label is notation and lives in code.
    -->
    <string name="key_text_keyboard_label">ABC</string>
    <string name="key_numeric_keypad_label">123</string>

    <!--
        How an expression is spoken (docs/CONVENTIONS.md §8). These are read out loud in a
        sentence, so they are lower case and carry no punctuation: TalkBack supplies the
        pauses. A translator is translating words in a sentence, not labels on keys.
    -->
    <string name="speech_plus">plus</string>
    <string name="speech_minus">minus</string>
    <string name="speech_times">times</string>
    <string name="speech_divided_by">divided by</string>
    <string name="speech_modulo">modulo</string>
    <string name="speech_to_the_power_of">to the power of</string>
    <string name="speech_percent_of">of</string>
    <string name="speech_negative">negative</string>
    <string name="speech_percent">percent</string>
    <string name="speech_factorial">factorial</string>
    <string name="speech_degrees">degrees</string>
    <string name="speech_of">of</string>
    <string name="speech_and">and</string>
    <string name="speech_to">to</string>
    <string name="speech_assigned">is</string>
    <string name="speech_open_bracket">open bracket</string>
    <string name="speech_close_bracket">close bracket</string>
    <string name="speech_line">line</string>


    <!--
        Error messages. One per CalcError variant, because the editor must never render an
        error it has no words for. docs/CONVENTIONS.md §8: never colour alone.
    -->
    <string name="error_syntax">Unexpected \'%1$s\'</string>
    <plurals name="error_unbalanced_paren">
        <item quantity="one">%1$d bracket still open</item>
        <item quantity="other">%1$d brackets still open</item>
    </plurals>
    <string name="error_unknown_identifier">Unknown name \'%1$s\'</string>
    <string name="error_unit_mismatch">Cannot combine %1$s and %2$s</string>
    <string name="error_domain">%1$s cannot take that value</string>
    <string name="error_circular_reference">These lines refer to each other in a circle</string>
    <string name="error_division_by_zero">Division by zero</string>
    <string name="error_overflow">Number too large to represent</string>
    <string name="error_rate_unavailable">No exchange rate for %1$s to %2$s</string>

    <string name="editor_fix_to">Use \'%1$s\'</string>
